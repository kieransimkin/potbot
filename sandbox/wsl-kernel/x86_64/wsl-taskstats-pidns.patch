 struct listener_list {
@@ -102,56 +111,6 @@
 	genlmsg_end(skb, reply);
 
 	return genlmsg_reply(skb, info);
-}
-
-/*
- * Send taskstats data in @skb to listeners registered for @cpu's exit data
- */
-static void send_cpu_listeners(struct sk_buff *skb,
-					struct listener_list *listeners)
-{
-	struct genlmsghdr *genlhdr = nlmsg_data(nlmsg_hdr(skb));
-	struct listener *s, *tmp;
-	struct sk_buff *skb_next, *skb_cur = skb;
-	void *reply = genlmsg_data(genlhdr);
-	int delcount = 0;
-
-	genlmsg_end(skb, reply);
-
-	down_read(&listeners->sem);
-	list_for_each_entry(s, &listeners->list, list) {
-		int rc;
-
-		skb_next = NULL;
-		if (!list_is_last(&s->list, &listeners->list)) {
-			skb_next = skb_clone(skb_cur, GFP_KERNEL);
-			if (!skb_next)
-				break;
-		}
-		rc = genlmsg_unicast(&init_net, skb_cur, s->pid);
-		if (rc == -ECONNREFUSED) {
-			s->valid = 0;
-			delcount++;
-		}
-		skb_cur = skb_next;
-	}
-	up_read(&listeners->sem);
-
-	if (skb_cur)
-		nlmsg_free(skb_cur);
-
-	if (!delcount)
-		return;
-
-	/* Delete invalidated entries */
-	down_write(&listeners->sem);
-	list_for_each_entry_safe(s, tmp, &listeners->list, list) {
-		if (!s->valid) {
-			list_del(&s->list);
-			kfree(s);
-		}
-	}
-	up_write(&listeners->sem);
 }
 
 static void exe_add_tsk(struct taskstats *stats, struct task_struct *tsk)
@@ -296,63 +255,96 @@
 	return;
 }
 
-static int add_del_listener(pid_t pid, const struct cpumask *mask, int isadd)
+static void del_listeners(struct listener_socket *socket,
+			  const struct cpumask *mask)
 {
 	struct listener_list *listeners;
-	struct listener *s, *tmp, *s2;
+	struct listener *entry;
 	unsigned int cpu;
-	int ret = 0;
-
-	if (!cpumask_subset(mask, cpu_possible_mask))
-		return -EINVAL;
-
-	if (current_user_ns() != &init_user_ns)
-		return -EINVAL;
-
-	if (task_active_pid_ns(current) != &init_pid_ns)
-		return -EINVAL;
-
-	if (isadd == REGISTER) {
-		for_each_cpu(cpu, mask) {
-			s = kmalloc_node(sizeof(struct listener),
-					GFP_KERNEL, cpu_to_node(cpu));
-			if (!s) {
-				ret = -ENOMEM;
-				goto cleanup;
-			}
-			s->pid = pid;
-			s->valid = 1;
-
-			listeners = &per_cpu(listener_array, cpu);
-			down_write(&listeners->sem);
-			list_for_each_entry(s2, &listeners->list, list) {
-				if (s2->pid == pid && s2->valid)
-					goto exists;
-			}
-			list_add(&s->list, &listeners->list);
-			s = NULL;
-exists:
-			up_write(&listeners->sem);
-			kfree(s); /* nop if NULL */
-		}
-		return 0;
-	}
-
-	/* Deregister or cleanup */
-cleanup:
-	for_each_cpu(cpu, mask) {
+
+	for_each_cpu_and(cpu, &socket->cpus, mask) {
 		listeners = &per_cpu(listener_array, cpu);
 		down_write(&listeners->sem);
-		list_for_each_entry_safe(s, tmp, &listeners->list, list) {
-			if (s->pid == pid) {
-				list_del(&s->list);
-				kfree(s);
+		list_for_each_entry(entry, &listeners->list, list) {
+			if (entry->socket == socket) {
+				list_del(&entry->list);
+				kfree(entry);
 				break;
 			}
 		}
 		up_write(&listeners->sem);
-	}
-	return ret;
+		cpumask_clear_cpu(cpu, &socket->cpus);
+	}
+}
+
+static void destroy_listener_socket(void *priv)
+{
+	struct listener_socket *socket = priv;
+
+	del_listeners(socket, cpu_possible_mask);
+	if (socket->pid_ns)
+		put_pid_ns(socket->pid_ns);
+}
+
+static int add_del_listener(struct sock *sk, u32 portid,
+			    const struct cpumask *mask, int action)
+{
+	struct pid_namespace *pid_ns = task_active_pid_ns(current);
+	struct listener_socket *socket;
+	struct listener *entry, *tmp;
+	struct listener_list *listeners;
+	unsigned int cpu;
+	LIST_HEAD(pending);
+
+	if (!cpumask_subset(mask, cpu_possible_mask) ||
+	    current_user_ns() != &init_user_ns)
+		return -EINVAL;
+
+	socket = genl_sk_priv_get(&family, sk);
+	if (IS_ERR(socket))
+		return PTR_ERR(socket);
+
+	if (socket->pid_ns && socket->pid_ns != pid_ns)
+		return -EPERM;
+
+	if (action == DEREGISTER) {
+		del_listeners(socket, mask);
+		return 0;
+	}
+
+	/* Allocate the entire change before publishing any CPU subscription. */
+	for_each_cpu(cpu, mask) {
+		if (cpumask_test_cpu(cpu, &socket->cpus))
+			continue;
+		entry = kmalloc_node(sizeof(*entry), GFP_KERNEL, cpu_to_node(cpu));
+		if (!entry)
+			goto free_pending;
+		entry->socket = socket;
+		entry->cpu = cpu;
+		list_add_tail(&entry->list, &pending);
+	}
+
+	if (!socket->pid_ns) {
+		socket->pid_ns = get_pid_ns(pid_ns);
+		socket->sk = sk;
+		socket->portid = portid;
+	}
+
+	list_for_each_entry_safe(entry, tmp, &pending, list) {
+		listeners = &per_cpu(listener_array, entry->cpu);
+		cpumask_set_cpu(entry->cpu, &socket->cpus);
+		down_write(&listeners->sem);
+		list_move(&entry->list, &listeners->list);
+		up_write(&listeners->sem);
+	}
+	return 0;
+
+free_pending:
+	list_for_each_entry_safe(entry, tmp, &pending, list) {
+		list_del(&entry->list);
+		kfree(entry);
+	}
+	return -ENOMEM;
 }
 
 static int parse(struct nlattr *na, struct cpumask *mask)
@@ -450,7 +442,7 @@
 	return send_reply(rep_skb, info);
 }
 
-static int cmd_attr_register_cpumask(struct genl_info *info)
+static int cmd_attr_register_cpumask(struct sk_buff *skb, struct genl_info *info)
 {
