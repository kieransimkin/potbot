Subject: [PATCH] taskstats: scope exit listeners to their PID namespace

WSL distributions run in nested PID namespaces. Allow their privileged
operators to subscribe to task exit statistics and report task IDs relative
to each recipient. Associate subscriptions with the Generic Netlink socket
so a recycled port ID cannot receive the previous owner's events.

---

diff --git a/include/linux/netlink.h b/include/linux/netlink.h
--- a/include/linux/netlink.h
+++ b/include/linux/netlink.h
@@ -227,6 +227,8 @@
 bool netlink_strict_get_check(struct sk_buff *skb);
 
 int netlink_unicast(struct sock *ssk, struct sk_buff *skb, __u32 portid, int nonblock);
+int netlink_unicast_checked(struct sock *ssk, struct sk_buff *skb, u32 portid,
+			   struct sock *expected);
 int netlink_broadcast(struct sock *ssk, struct sk_buff *skb, __u32 portid,
 		      __u32 group, gfp_t allocation);
 
diff --git a/net/netlink/af_netlink.c b/net/netlink/af_netlink.c
--- a/net/netlink/af_netlink.c
+++ b/net/netlink/af_netlink.c
@@ -1326,8 +1326,9 @@
 	return ret;
 }
 
-int netlink_unicast(struct sock *ssk, struct sk_buff *skb,
-		    u32 portid, int nonblock)
+static int netlink_unicast_to(struct sock *ssk, struct sk_buff *skb,
+			      u32 portid, int nonblock,
+			      struct sock *expected)
 {
 	struct sock *sk;
 	int err;
@@ -1342,6 +1343,12 @@
 		kfree_skb(skb);
 		return PTR_ERR(sk);
 	}
+	/* A closed socket's port ID may already belong to another client. */
+	if (expected && sk != expected) {
+		sock_put(sk);
+		kfree_skb(skb);
+		return -ECONNREFUSED;
+	}
 	if (netlink_is_kernel(sk))
 		return netlink_unicast_kernel(sk, skb, ssk);
 
@@ -1360,7 +1367,19 @@
 
 	return netlink_sendskb(sk, skb);
 }
+
+int netlink_unicast(struct sock *ssk, struct sk_buff *skb,
+		    u32 portid, int nonblock)
+{
+	return netlink_unicast_to(ssk, skb, portid, nonblock, NULL);
+}
 EXPORT_SYMBOL(netlink_unicast);
+
+int netlink_unicast_checked(struct sock *ssk, struct sk_buff *skb, u32 portid,
+			    struct sock *expected)
+{
+	return netlink_unicast_to(ssk, skb, portid, MSG_DONTWAIT, expected);
+}
 
 int netlink_has_listeners(struct sock *sk, unsigned int group)
 {
diff --git a/kernel/taskstats.c b/kernel/taskstats.c
--- a/kernel/taskstats.c
+++ b/kernel/taskstats.c
@@ -20,6 +20,7 @@
