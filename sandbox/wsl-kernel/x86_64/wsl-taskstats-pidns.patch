-	rc = add_del_listener(info->snd_portid, mask, DEREGISTER);
+	rc = add_del_listener(NETLINK_CB(skb).sk, info->snd_portid,
+			      mask, DEREGISTER);
 out:
 	free_cpumask_var(mask);
 	return rc;
@@ -554,9 +548,9 @@
 static int taskstats_user_cmd(struct sk_buff *skb, struct genl_info *info)
 {
 	if (info->attrs[TASKSTATS_CMD_ATTR_REGISTER_CPUMASK])
-		return cmd_attr_register_cpumask(info);
+		return cmd_attr_register_cpumask(skb, info);
 	else if (info->attrs[TASKSTATS_CMD_ATTR_DEREGISTER_CPUMASK])
-		return cmd_attr_deregister_cpumask(info);
+		return cmd_attr_deregister_cpumask(skb, info);
 	else if (info->attrs[TASKSTATS_CMD_ATTR_PID])
 		return cmd_attr_pid(info);
 	else if (info->attrs[TASKSTATS_CMD_ATTR_TGID])
@@ -597,68 +591,75 @@
 	return stats;
 }
 
+static void send_task_exit(struct listener_socket *socket,
+			   struct task_struct *tsk, pid_t pid, int group_dead,
+			   bool send_tgid, size_t size)
+{
+	struct genlmsghdr *genlhdr;
+	struct taskstats *stats;
+	struct sk_buff *skb;
+
+	if (prepare_reply(NULL, TASKSTATS_CMD_NEW, &skb, size) < 0)
+		return;
+
+	stats = mk_reply(skb, TASKSTATS_TYPE_PID, pid);
+	if (!stats)
+		goto err;
+	fill_stats(&init_user_ns, socket->pid_ns, tsk, stats);
+	if (group_dead)
+		stats->ac_flag |= AGROUP;
+
+	if (send_tgid) {
+		stats = mk_reply(skb, TASKSTATS_TYPE_TGID,
+				 task_tgid_nr_ns(tsk, socket->pid_ns));
+		if (!stats)
+			goto err;
+		memcpy(stats, tsk->signal->stats, sizeof(*stats));
+		stats->version = TASKSTATS_VERSION;
+	}
+
+	genlhdr = nlmsg_data(nlmsg_hdr(skb));
+	genlmsg_end(skb, genlmsg_data(genlhdr));
+	netlink_unicast_checked(sock_net(socket->sk)->genl_sock, skb,
+				socket->portid, socket->sk);
+	return;
+err:
+	nlmsg_free(skb);
+}
+
 /* Send pid data out on exit */
 void taskstats_exit(struct task_struct *tsk, int group_dead)
 {
-	int rc;
 	struct listener_list *listeners;
-	struct taskstats *stats;
-	struct sk_buff *rep_skb;
+	struct listener *entry;
+	bool send_tgid;
 	size_t size;
-	int is_thread_group;
 
 	if (!family_registered)
 		return;
 
-	/*
-	 * Size includes space for nested attributes
-	 */
-	size = taskstats_packet_size();
-
-	is_thread_group = !!taskstats_tgid_alloc(tsk);
-	if (is_thread_group) {
-		/* PID + STATS + TGID + STATS */
-		size = 2 * size;
-		/* fill the tsk->signal->stats structure */
+	if (taskstats_tgid_alloc(tsk)) {
 		fill_tgid_exit(tsk);
+		send_tgid = group_dead;
+	} else {
+		send_tgid = false;
 	}
 
 	listeners = raw_cpu_ptr(&listener_array);
 	if (list_empty(&listeners->list))
 		return;
 
-	rc = prepare_reply(NULL, TASKSTATS_CMD_NEW, &rep_skb, size);
-	if (rc < 0)
-		return;
-
-	stats = mk_reply(rep_skb, TASKSTATS_TYPE_PID,
-			 task_pid_nr_ns(tsk, &init_pid_ns));
-	if (!stats)
-		goto err;
-
-	fill_stats(&init_user_ns, &init_pid_ns, tsk, stats);
-	if (group_dead)
-		stats->ac_flag |= AGROUP;
-
-	/*
-	 * Doesn't matter if tsk is the leader or the last group member leaving
-	 */
-	if (!is_thread_group || !group_dead)
-		goto send;
-
-	stats = mk_reply(rep_skb, TASKSTATS_TYPE_TGID,
-			 task_tgid_nr_ns(tsk, &init_pid_ns));
-	if (!stats)
-		goto err;
-
-	memcpy(stats, tsk->signal->stats, sizeof(*stats));
-	stats->version = TASKSTATS_VERSION;
-
-send:
-	send_cpu_listeners(rep_skb, listeners);
-	return;
-err:
-	nlmsg_free(rep_skb);
+	size = taskstats_packet_size() * (send_tgid ? 2 : 1);
+	down_read(&listeners->sem);
+	list_for_each_entry(entry, &listeners->list, list) {
+		struct listener_socket *socket = entry->socket;
+		pid_t pid = task_pid_nr_ns(tsk, socket->pid_ns);
+
+		/* Hide tasks outside the recipient's PID namespace subtree. */
+		if (pid)
+			send_task_exit(socket, tsk, pid, group_dead, send_tgid, size);
+	}
+	up_read(&listeners->sem);
 }
 
 static const struct genl_ops taskstats_ops[] = {
@@ -687,6 +688,8 @@
 	.n_ops		= ARRAY_SIZE(taskstats_ops),
 	.resv_start_op	= CGROUPSTATS_CMD_GET + 1,
 	.netnsok	= true,
+	.sock_priv_size = sizeof(struct listener_socket),
+	.sock_priv_destroy = destroy_listener_socket,
 };
 
