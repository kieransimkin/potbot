# UI-3: operator-scoped bridge to the EXISTING Potbot backend.
# Copy to .env.local (NEVER commit .env.local). It contains sensitive secrets.
# Browser users log in with the UI password; Potbot bearer tokens stay on Next.js server.
# This is a single-operator bridge, not yet a multi-user/workspace identity system.
POTBOT_UI_PUBLIC_ORIGIN=http://127.0.0.1:3100
POTBOT_UI_PASSWORD=replace-with-a-long-unique-local-password
POTBOT_UI_COOKIE_SECRET=replace-with-at-least-32-random-characters-from-a-password-manager
POTBOT_UI_BACKEND_URL=http://127.0.0.1:8000
POTBOT_UI_BACKEND_TOKEN=replace-with-workspace-scoped-potbot-bearer-token
POTBOT_UI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
POTBOT_UI_WORKSPACE_NAME=Potbot
POTBOT_UI_MODEL=potbot

# Optional Xpra-only seamless application bridge (private token never shipped to JS).
# Requires an Xpra session on the selected workspace and prepared pinned HTML5 assets.
POTBOT_UI_XPRA_BRIDGE_URL=http://127.0.0.1:8765/
POTBOT_UI_XPRA_BRIDGE_TOKEN=replace-with-a-long-unique-private-service-token
POTBOT_UI_XPRA_PUBLIC_WS_URL=ws://127.0.0.1:8765/v1/xpra/ws
