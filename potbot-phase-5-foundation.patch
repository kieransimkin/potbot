+        uuid4(),
+    )
+    rig.response = ModelCodingResponse(
+        UUID(rig.handoff["id"]),
+        rig.state["id"],
+        rig.contract_id,
+        patch=rig.patch,
+        changed_files=("calculator.py",),
+        proposed_checks=("calculator-tests",),
