+
+@pytest.fixture
+def rig(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> SimpleNamespace:
+    pipeline_id, export_id = uuid4(), uuid4()
+    pipeline = SimpleNamespace(
