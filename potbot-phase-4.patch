+        ["demo", "--fixtures", "fixtures", "--key", " "],
+        ["demo", "--fixtures", "fixtures", "--key", "x" * 129],
+        ["demo", "--fixtures", "fixtures", "--key", "key", "--stop-after", "unknown"],
+        ["--schema", "bad;schema", "inspect", str(uuid4())],
+        ["export", str(uuid4())],
