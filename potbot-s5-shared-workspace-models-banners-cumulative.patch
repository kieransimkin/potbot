+            self.ws_a, self.agent_a, "github.update_ref", "one", "write", (repo,), DIGEST_A
+        ))
+        with self.assertRaises(StateMismatchError):
+            self.b.claim(AccessRequest(
+                self.ws_b, self.agent_b, "github.update_ref", "two", "write", (repo,), DIGEST_A
+            ))
