{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synny://schema/syn-p2p-lan/v1",
  "title": "SYN LAN P2P v1 public wire types",
  "description": "Structural validation only. Ed25519 verification, endpoint pinning, freshness, AES-GCM authentication, hardware confidentiality and durable anti-replay are mandatory runtime checks. This schema grants no enrollment authority.",
  "oneOf": [
    {"$ref": "#/$defs/advertisement"},
    {"$ref": "#/$defs/signedOffer"},
    {"$ref": "#/$defs/clientHello"},
    {"$ref": "#/$defs/serverHello"},
    {"$ref": "#/$defs/encryptedFrame"},
    {"$ref": "#/$defs/outcome"}
  ],
  "$defs": {
    "hex32": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "hex64": {"type":"string","pattern":"^[0-9a-f]{128}$"},
    "hardwareId": {"type":"string","minLength":12,"maxLength":512,"pattern":"^(?:[0-9a-f]{2}){6,256}$"},
    "unsignedSeconds": {"type":"integer","minimum":1,"maximum":9223372036854775807},
    "pulse": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","network_id","master_public_key_hash","challenge","issued_at","expires_at"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-operator-pulse-v1"},
        "network_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
        "master_public_key_hash":{"$ref":"#/$defs/hex32"},
        "challenge":{"$ref":"#/$defs/hex32"},
        "issued_at":{"$ref":"#/$defs/unsignedSeconds"},"expires_at":{"$ref":"#/$defs/unsignedSeconds"}
      }
    },
    "signedPulse": {
      "type":"object","additionalProperties":false,
      "required":["pulse","operator_public_key","signature"],
      "properties":{
        "pulse":{"$ref":"#/$defs/pulse"},
        "operator_public_key":{"$ref":"#/$defs/hex32"},
        "signature":{"$ref":"#/$defs/hex64"}
      }
    },
    "advertisement": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","host","port","signed_pulse","signature"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-p2p-advertisement-v1"},
        "host":{"type":"string","format":"ipv4"},"port":{"type":"integer","minimum":1,"maximum":65535},
        "signed_pulse":{"$ref":"#/$defs/signedPulse"},"signature":{"$ref":"#/$defs/hex64"}
      }
    },
    "offer": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","temporary_public_key_hash","hardware_unique_id","timestamp_unix_seconds","target_master_public_key_hash","pulse_challenge"],
      "properties":{
        "schema_version":{"const":2},"type_ref":{"const":"synny://type/syn-agent-pledge-offer-v2"},
        "temporary_public_key_hash":{"$ref":"#/$defs/hex32"},
        "hardware_unique_id":{"$ref":"#/$defs/hardwareId"},
        "timestamp_unix_seconds":{"$ref":"#/$defs/unsignedSeconds"},
        "target_master_public_key_hash":{"$ref":"#/$defs/hex32"},
        "pulse_challenge":{"$ref":"#/$defs/hex32"}
      }
    },
    "signedOffer": {
      "type":"object","additionalProperties":false,
      "required":["offer","temporary_public_key","signature"],
      "properties":{
        "offer":{"$ref":"#/$defs/offer"},
        "temporary_public_key":{"$ref":"#/$defs/hex32"},"signature":{"$ref":"#/$defs/hex64"}
      }
    },
    "clientHello": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","advert_sha256","public","nonce"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-p2p-client-hello-v1"},
        "advert_sha256":{"$ref":"#/$defs/hex32"},"public":{"$ref":"#/$defs/hex32"},
        "nonce":{"$ref":"#/$defs/hex32"}
      }
    },
    "serverHello": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","advert_sha256","client_public","client_nonce","server_public","nonce","signature"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-p2p-server-hello-v1"},
        "advert_sha256":{"$ref":"#/$defs/hex32"},"client_public":{"$ref":"#/$defs/hex32"},
        "client_nonce":{"$ref":"#/$defs/hex32"},"server_public":{"$ref":"#/$defs/hex32"},
        "nonce":{"$ref":"#/$defs/hex32"},"signature":{"$ref":"#/$defs/hex64"}
      }
    },
    "encryptedFrame": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","ciphertext"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-p2p-encrypted-frame-v1"},
        "ciphertext":{"type":"string","pattern":"^[0-9a-f]+$","minLength":32,"maxLength":8300}
      }
    },
    "outcome": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","type_ref","state","offer_sha256","activation_authorized"],
      "properties":{
        "schema_version":{"const":1},"type_ref":{"const":"synny://type/syn-p2p-pledge-outcome-v1"},
        "state":{"const":"pending-operator-review"},"offer_sha256":{"$ref":"#/$defs/hex32"},
        "activation_authorized":{"const":false}
      }
    }
  }
}
