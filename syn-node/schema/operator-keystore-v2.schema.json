{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synny://schema/syn-python-operator-keystore/v2",
  "title": "SYN Python operator installation public descriptor and v2 daemon configuration",
  "oneOf": [{"$ref": "#/$defs/identity"}, {"$ref": "#/$defs/config"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type_ref", "profile", "root_path", "base_path", "root_public_key", "base_public_key", "root_public_key_hash", "base_public_key_hash"],
      "properties": {
        "schema_version": {"const": 1},
        "type_ref": {"const": "synny://type/syn-operator-public-identity-v1"},
        "profile": {"const": "syn-icarus-ed25519-bip32-v2"},
        "root_path": {"const": "m/6969'/420'"},
        "base_path": {"const": "m/6969'/420'/0'/0/0"},
        "root_public_key": {"$ref": "#/$defs/hash"},
        "base_public_key": {"$ref": "#/$defs/hash"},
        "root_public_key_hash": {"$ref": "#/$defs/hash"},
        "base_public_key_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type_ref", "mode", "socket", "registry", "receipt_db", "expected_base_public_key_hash", "keyring_service", "keyring_account"],
      "properties": {
        "schema_version": {"const": 2},
        "type_ref": {"const": "synny://type/syn-local-service-config-v2"},
        "mode": {"enum": ["operator", "agent"]},
        "socket": {"type": "string", "minLength": 1},
        "registry": {"type": "string", "minLength": 1},
        "receipt_db": {"oneOf": [{"type":"null"},{"type":"string", "minLength":1}]},
        "expected_base_public_key_hash": {"$ref": "#/$defs/hash"},
        "keyring_service": {"type": "string", "minLength": 1, "maxLength": 128},
        "keyring_account": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
