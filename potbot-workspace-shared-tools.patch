+"""Offline, real-Git acceptance for workspace shared tools and per-agent forks."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from potbot.domain.errors import InvalidInputError, ScopeDeniedError, StateMismatchError
+from potbot.tools.shared_installations import SharedToolRecipe, SharedToolStore
+from potbot.workspace_sandbox import WorkspaceSandbox
+
+
+def git(*args: str, cwd: Path | None = None) -> str:
+    result = subprocess.run(
+        [shutil.which("git") or "git", *args],
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return result.stdout.strip()
+
+
+@pytest.fixture
+def ready_tool(tmp_path: Path) -> tuple[WorkspaceSandbox, SharedToolStore, SharedToolRecipe]:
+    sandbox = WorkspaceSandbox.prepare(tmp_path / "registered")
+    source = sandbox.path("repository") / "calculator"
+    source.mkdir()
+    git("init", "-q", cwd=source)
+    git("config", "user.email", "fixture@example.invalid", cwd=source)
+    git("config", "user.name", "Fixture", cwd=source)
+    (source / ".gitignore").write_text(".cache/\n", encoding="utf-8")
+    (source / "bin").mkdir()
+    launcher = source / "bin" / "calculator"
+    launcher.write_text("#!/bin/sh\nprintf 'ok\\n'\n", encoding="utf-8")
+    launcher.chmod(0o755)
+    git("add", ".", cwd=source)
+    git("commit", "-qm", "pinned tool", cwd=source)
+    revision = git("rev-parse", "HEAD", cwd=source)
+    recipe = SharedToolRecipe(
+        "calculator",
+        "https://github.com/example/calculator",
+        revision,
+        "checkout/bin/calculator",
+        "linux-x86_64-glibc-py313",
+        False,
+    )
+    store = SharedToolStore(sandbox)
+    tool_root = store.stage(recipe, source)
+    (tool_root / "downloads").mkdir(exist_ok=True)
+    (tool_root / "downloads" / "wheel.whl").write_bytes(b"static download")
+    (tool_root / "build").mkdir(exist_ok=True)
+    (tool_root / "build" / "native.so").write_bytes(b"precompiled binary")
+    (tool_root / "environment").mkdir(exist_ok=True)
+    (tool_root / "environment" / "python").write_bytes(b"shared venv")
+    store.register(recipe)
+    return sandbox, store, recipe
+
+
+def test_agent_home_is_private_and_guest_alias_is_exact(tmp_path: Path) -> None:
+    sandbox = WorkspaceSandbox.prepare(tmp_path / "ws")
+    first = sandbox.agent_home("agent-one")
+    second = sandbox.agent_home("agent-two")
+    assert first != second
+    assert first.is_relative_to(sandbox.path("environments"))
+    assert os.readlink(first / "Tools") == "/usr/local/tools"
+    assert os.readlink(second / "Tools") == "/usr/local/tools"
+    assert sandbox.agent_runtime_environment("agent-one")["HOME"] == "/home/user"
+    assert sandbox.agent_runtime_environment("agent-one")["PIP_CACHE_DIR"].startswith(
+        "/home/user/.cache/"
+    )
+    for bad in ("../escape", "x/y", "", "../../tmp", "agent with spaces"):
+        with pytest.raises(InvalidInputError):
+            sandbox.agent_home(bad)
+    (first / "Tools").unlink()
+    (first / "Tools").symlink_to("/tmp/escape")
+    with pytest.raises(ScopeDeniedError):
+        sandbox.agent_home("agent-one")
+
+
+def test_shared_use_clean_and_fork_retains_static_assets(ready_tool) -> None:
+    sandbox, store, recipe = ready_tool
+    shared = sandbox.path("tools") / "calculator"
+    with store.use("calculator", abi_tag=recipe.abi_tag) as installed:
+        assert installed.executable == shared / "checkout" / "bin" / "calculator"
+        assert installed.guest_root == "/usr/local/tools/calculator"
+        assert installed.model_environment == {}
+    checkout = shared / "checkout"
+    (checkout / "bin" / "calculator").write_text("broken", encoding="utf-8")
+    (checkout / "temp.log").write_text("runtime", encoding="utf-8")
+    (checkout / ".cache").mkdir()
+    (checkout / ".cache" / "bundle").write_text("runtime", encoding="utf-8")
+    with pytest.raises(StateMismatchError):
+        with store.use("calculator", abi_tag=recipe.abi_tag):
+            pass
+    store.clean("calculator")
+    assert not (checkout / "temp.log").exists()
+    assert not (checkout / ".cache").exists()
+    assert (checkout / "bin" / "calculator").read_text().startswith("#!/bin/sh")
+    assert (shared / "downloads" / "wheel.whl").read_bytes() == b"static download"
+    assert (shared / "build" / "native.so").read_bytes() == b"precompiled binary"
+    assert (shared / "environment" / "python").read_bytes() == b"shared venv"
+    clone = store.fork_for_edit("calculator", "agent-one")
+    assert clone == sandbox.agent_home("agent-one") / "Projects" / "calculator"
+    assert git("rev-parse", "HEAD", cwd=clone) == recipe.commit
+    assert git("rev-parse", "--is-shallow-repository", cwd=clone) == "false"
+    (clone / "bin" / "calculator").write_text("agent edit", encoding="utf-8")
+    with store.use("calculator", abi_tag=recipe.abi_tag) as installed:
+        assert installed.executable.read_text().startswith("#!/bin/sh")
+    with pytest.raises(StateMismatchError):
+        store.fork_for_edit("calculator", "agent-one")
+
+
+def test_abi_and_launcher_integrity_checked(ready_tool) -> None:
+    sandbox, store, recipe = ready_tool
+    with pytest.raises(StateMismatchError):
+        with store.use("calculator", abi_tag="linux-aarch64-glibc-py313"):
+            pass
+    launcher = sandbox.path("tools") / "calculator" / "checkout" / "bin" / "calculator"
+    launcher.unlink()
+    launcher.symlink_to("/etc/passwd")
+    with pytest.raises((StateMismatchError, ScopeDeniedError)):
+        with store.use("calculator", abi_tag=recipe.abi_tag):
+            pass
+
+
+def test_model_gate_and_agent_runtime_clean(ready_tool) -> None:
+    sandbox, store, _ = ready_tool
+    with pytest.raises(InvalidInputError):
+        SharedToolRecipe(
+            "bad", "https://github.com/example/bad", "a" * 40,
+            "checkout/bin/run", "linux-x86_64", True,
+        )
+    with pytest.raises(InvalidInputError):
+        SharedToolRecipe(
+            "bad", "https://github.com/example/bad", "a" * 40,
+            "checkout/bin/run", "linux-x86_64", True, ("/home/user/models",),
+        )
+    recipe = SharedToolRecipe(
+        "model-tool", "https://github.com/example/model-tool", "a" * 40,
+        "checkout/bin/run", "linux-x86_64", True, ("/var/ai/model-tool",),
+    )
+    assert SharedToolStore.model_environment(recipe)["HF_HOME"].startswith("/var/ai/")
+    first = sandbox.agent_home("alice")
+    second = sandbox.agent_home("bob")
+    for home in (first, second):
+        for root in (home / ".cache", home / ".local" / "state", home / ".local" / "tmp"):
+            cache = root / "tools" / "calculator"
+            cache.mkdir(parents=True)
+            (cache / "unused").write_text("temporary", encoding="utf-8")
+    store.clean_agent_runtime("calculator", "alice")
+    for root in (first / ".cache", first / ".local" / "state", first / ".local" / "tmp"):
+        assert not (root / "tools" / "calculator").exists()
+    for root in (second / ".cache", second / ".local" / "state", second / ".local" / "tmp"):
+        assert (root / "tools" / "calculator" / "unused").exists()
