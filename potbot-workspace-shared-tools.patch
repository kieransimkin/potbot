+"""Guest namespace and admission tests for one workspace's shared tool store."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import pytest
+
+from potbot.domain.errors import CapabilityUnavailableError, InvalidInputError
+from potbot.tools import isolation
+from potbot.tools.isolation import BubblewrapBackend
+from potbot.tools.supervisor import ProcessRequest
+from potbot.workspace_sandbox import WorkspaceSandbox
+
+
+def test_request_rejects_cross_workspace_agent_mounts(tmp_path: Path) -> None:
+    first = WorkspaceSandbox.prepare(tmp_path / "one")
+    second = WorkspaceSandbox.prepare(tmp_path / "two")
+    source = first.path("candidates") / "candidate"
+    source.mkdir()
+    common = dict(
+        argv=("/bin/true",), cwd=source, workspace_root=source,
+        sandbox_root=first.root,
+        shared_tools_root=first.path("tools"),
+        agent_home_root=first.agent_home("agent-1"),
+        models_root=first.path("models"),
+    )
+    request = ProcessRequest(**common)
+    assert request.shared_tools_root == first.path("tools")
+    with pytest.raises(InvalidInputError):
+        ProcessRequest(**{**common, "agent_home_root": second.agent_home("agent-2")})
+    with pytest.raises(InvalidInputError):
+        ProcessRequest(**{**common, "shared_tools_root": second.path("tools")})
+    with pytest.raises(InvalidInputError):
+        ProcessRequest(**{**common, "models_root": second.path("models")})
+    with pytest.raises(InvalidInputError):
+        ProcessRequest(**{**common, "agent_home_root": None, "shared_tools_write": True})
+    with pytest.raises(InvalidInputError):
+        ProcessRequest(**{**common, "shared_tools_write": "true"})
+
+
+def test_agent_profile_ro_and_operator_only_rw_binds(tmp_path: Path, monkeypatch) -> None:
+    sandbox = WorkspaceSandbox.prepare(tmp_path / "qualified")
+    candidate = sandbox.path("candidates") / "candidate"
+    candidate.mkdir()
+    home = sandbox.agent_home("agent-1")
+    # Exercise base-image mountpoint precondition with a temporary stand-in.
+    # The real deployed guest location is always /usr/local/tools.
+    guest_placeholder = tmp_path / "image" / "usr" / "local" / "tools"
+    guest_home = tmp_path / "image" / "home" / "user"
+    guest_models = tmp_path / "image" / "var" / "ai"
+    for folder in (guest_placeholder, guest_home, guest_models):
+        folder.mkdir(parents=True)
+    (home / "Tools").unlink()
+    (home / "Tools").symlink_to(str(guest_placeholder))
+    monkeypatch.setattr(isolation, "GUEST_TOOLS_ROOT", str(guest_placeholder))
+    monkeypatch.setattr(isolation, "GUEST_AGENT_HOME", str(guest_home))
+    monkeypatch.setattr(isolation, "GUEST_MODELS_ROOT", str(guest_models))
+    monkeypatch.setattr(isolation, "_seccomp_fd", lambda **kw: os.open(os.devnull, os.O_RDONLY))
+    backend = BubblewrapBackend(executable=Path("/bin/true"), prlimit=Path("/bin/true"))
+
+    def prepare(write: bool):
+        launch = backend.prepare(
+            argv=("/bin/true",), cwd=candidate,
+            workspace_root=candidate, sandbox_root=sandbox.root,
+            read_only_roots=(), writable_roots=(), status_fd=1,
+            memory_bytes=128*1024*1024, cpu_seconds=60,
+            max_file_bytes=128*1024*1024, max_open_files=256,
+            shared_tools_root=sandbox.path("tools"),
+            agent_home_root=home, models_root=sandbox.path("models"),
+            shared_tools_write=write,
+        )
+        try:
+            return launch.argv
+        finally:
+            os.close(launch.pass_fds[0])
+
+    readonly = prepare(False)
+    writable = prepare(True)
+    assert ("--ro-bind", str(sandbox.path("tools")), str(guest_placeholder)) in tuple(
+        readonly[i:i+3] for i in range(len(readonly)-2)
+    )
+    assert ("--bind", str(sandbox.path("tools")), str(guest_placeholder)) in tuple(
+        writable[i:i+3] for i in range(len(writable)-2)
+    )
+    for argv in (readonly, writable):
+        triples = tuple(argv[i:i+3] for i in range(len(argv)-2))
+        assert ("--bind", str(home), str(guest_home)) in triples
+        assert ("--bind", str(sandbox.path("models")), str(guest_models)) in triples
+
+    guest_placeholder.rmdir()
+    with pytest.raises(CapabilityUnavailableError):
+        prepare(False)
