diff --git a/src/potbot/tools/shared_installations.py b/src/potbot/tools/shared_installations.py
new file mode 100644
--- /dev/null
+++ b/src/potbot/tools/shared_installations.py
@@ -0,0 +1,435 @@
+"""Workspace shared-tool lifecycle: pinned, reusable installs and isolated agent forks.
+
+This is a trusted *operator-side* workflow, not a model-invokable shell. Installation
+from network sources and execution of build scripts require separately admitted,
+sandboxed installer jobs. A normal tool consumer only obtains a read-only lease.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+from collections.abc import Iterator, Mapping
+from contextlib import contextmanager
+from dataclasses import asdict, dataclass
+from pathlib import Path, PurePosixPath
+
+from potbot.domain.errors import (
+    CapabilityUnavailableError,
+    InvalidInputError,
+    ScopeDeniedError,
+    StateMismatchError,
+)
+from potbot.workspace_sandbox import WorkspaceSandbox
+
+try:
+    import fcntl
+except ImportError:  # pragma: no cover - qualified local execution is Linux/WSL2
+    fcntl = None  # type: ignore[assignment]
+
+_NAME = re.compile(r"[a-z][a-z0-9_-]{0,63}\Z")
+_COMMIT = re.compile(r"[0-9a-f]{40}\Z")
+_TAG = re.compile(r"[a-zA-Z0-9._+-]{1,96}\Z")
+_SCHEMA = 1
+_STATIC_DIRS = ("downloads", "build", "environment")
+_RUNTIME_DIRS = ("cache", "state", "tmp")
+_ALLOWED_LAUNCHERS = frozenset({"checkout", "build", "environment"})
+
+
+def _relative_file(value: str) -> PurePosixPath:
+    path = PurePosixPath(value)
+    if (
+        not value
+        or "\\" in value
+        or path.is_absolute()
+        or path.as_posix() != value
+        or len(path.parts) < 2
+        or any(part in {"", ".", ".."} for part in path.parts)
+        or path.parts[0] not in _ALLOWED_LAUNCHERS
+    ):
+        raise InvalidInputError("Tool entrypoint must be inside a declared shared tool area")
+    return path
+
+
+@dataclass(frozen=True, slots=True)
+class SharedToolRecipe:
+    """Trusted install gate; data alone does not authorize downloads or execution."""
+
+    name: str
+    source_url: str
+    commit: str
+    entrypoint: str
+    abi_tag: str
+    downloads_models: bool
+    model_download_paths: tuple[str, ...] = ()
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.name, str) or not _NAME.fullmatch(self.name):
+            raise InvalidInputError("Invalid workspace tool name")
+        if not self.source_url.startswith("https://github.com/") or any(
+            character in self.source_url for character in ("\n", "\r", "\x00", " ")
+        ):
+            raise InvalidInputError("Tool source must be an explicit reviewed GitHub URL")
+        if not isinstance(self.commit, str) or not _COMMIT.fullmatch(self.commit):
+            raise InvalidInputError("Tool source must be pinned to a full commit SHA")
+        _relative_file(self.entrypoint)
+        if not isinstance(self.abi_tag, str) or not _TAG.fullmatch(self.abi_tag):
+            raise InvalidInputError("Shared build/environment requires an explicit ABI tag")
+        if type(self.downloads_models) is not bool:
+            raise InvalidInputError("Tool model-download discovery must be explicit")
+        if self.downloads_models != bool(self.model_download_paths):
+            raise InvalidInputError("Model-downloading tools must declare /var/ai destinations")
+        for value in self.model_download_paths:
+            if (
+                not isinstance(value, str)
+                or not value.startswith("/var/ai/")
+                or ".." in PurePosixPath(value).parts
+                or "\x00" in value
+            ):
+                raise InvalidInputError("Model downloads must be redirected below /var/ai")
+
+
+@dataclass(frozen=True, slots=True)
+class SharedToolUse:
+    """Retained only while the caller holds the shared use lock."""
+
+    root: Path
+    checkout: Path
+    executable: Path
+    environment: Path
+    commit: str
+    abi_tag: str
+    model_environment: Mapping[str, str]
+
+    @property
+    def guest_root(self) -> str:
+        return f"/usr/local/tools/{self.root.name}"
+
+    @property
+    def guest_executable(self) -> str:
+        """Approved guest path for ProcessRequest.argv[0], not a host path."""
+        return f"{self.guest_root}/{self.executable.relative_to(self.root).as_posix()}"
+
+
+class SharedToolStore:
+    """An isolated catalog under one registered workspace's ``tools/`` area.
+
+    Callers must authenticate the agent identity and authorize tool installation,
+    use, or edit via the existing controller. Git runs without a shell or network.
+    """
+
+    def __init__(self, sandbox: WorkspaceSandbox, *, git_binary: str | None = None) -> None:
+        if not isinstance(sandbox, WorkspaceSandbox):
+            raise InvalidInputError("A registered workspace sandbox is required")
+        self.sandbox = sandbox
+        self.root = sandbox.path("tools")
+        found = git_binary or shutil.which("git")
+        if not found or not Path(found).is_file():
+            raise CapabilityUnavailableError("An operator-pinned Git binary is required")
+        self.git = str(Path(found).resolve(strict=True))
+
+    def _location(self, name: str) -> Path:
+        if not isinstance(name, str) or not _NAME.fullmatch(name):
+            raise InvalidInputError("Invalid workspace tool name")
+        path = self.root / name
+        if path.is_symlink():
+            raise ScopeDeniedError("Shared tool root may not be a symbolic link")
+        return path
+
+    @contextmanager
+    def _lock(self, name: str, *, exclusive: bool) -> Iterator[None]:
+        """Controller-owned locks; untrusted writers cannot replace lock files."""
+        if fcntl is None:
+            raise CapabilityUnavailableError("Shared tools need qualified Linux file locks")
+        lock_dir = self.sandbox.path("receipts") / "shared-tool-locks"
+        lock_dir.mkdir(mode=0o700, exist_ok=True)
+        if lock_dir.is_symlink():
+            raise ScopeDeniedError("Shared tool lock directory is symlinked")
+        flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(lock_dir / f"{name}.lock", flags, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
+            yield
+        finally:
+            fcntl.flock(fd, fcntl.LOCK_UN)
+            os.close(fd)
+
+    def _git(self, *args: str, cwd: Path | None = None) -> str:
+        environment = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
+        environment.update(
+            GIT_CONFIG_NOSYSTEM="1",
+            GIT_CONFIG_GLOBAL=os.devnull,
+            GIT_TERMINAL_PROMPT="0",
+            GIT_LFS_SKIP_SMUDGE="1",
+        )
+        command = (
+            self.git,
+            "-c",
+            "core.hooksPath=/dev/null",
+            "-c",
+            "protocol.ext.allow=never",
+            "-c",
+            "filter.lfs.required=false",
+            *args,
+        )
+        result = subprocess.run(
+            command,
+            cwd=cwd,
+            env=environment,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            check=False,
+            timeout=120,
+        )
+        if result.returncode:
+            raise StateMismatchError(
+                "Pinned tool Git operation failed (exit " + str(result.returncode) + ")"
+            )
+        return result.stdout.decode("utf-8", "replace").strip()
+
+    def _clean_source(self, checkout: Path, commit: str) -> None:
+        if (
+            checkout.is_symlink()
+            or (checkout / ".git").is_symlink()
+            or not (checkout / ".git").is_dir()
+        ):
+            raise ScopeDeniedError("Expected an independent Git tool checkout")
+        if Path(self._git("-C", str(checkout), "rev-parse", "--show-toplevel")) != checkout:
+            raise ScopeDeniedError("Tool Git top-level does not match checkout")
+        self._git("-C", str(checkout), "reset", "--hard", commit)
+        self._git("-C", str(checkout), "clean", "-ffdx", "--", ".")
+        if self._git("-C", str(checkout), "rev-parse", "HEAD") != commit:
+            raise StateMismatchError("Tool checkout did not return to its pinned Git revision")
+        if self._git("-C", str(checkout), "status", "--porcelain=1", "--ignored"):
+            raise StateMismatchError("Tool cleanup left runtime or untracked files in checkout")
+
+    def _manifest_path(self, name: str) -> Path:
+        location = self.sandbox.path("receipts") / "shared-tool-manifests"
+        if location.is_symlink():
+            raise ScopeDeniedError("Trusted tool manifest store is symlinked")
+        location.mkdir(mode=0o700, exist_ok=True)
+        return location / f"{name}.json"
+
+    def _read_recipe(self, name: str) -> tuple[SharedToolRecipe, str]:
+        manifest = self._manifest_path(name)
+        if manifest.is_symlink() or not manifest.is_file():
+            raise ScopeDeniedError("Shared tool is not published")
+        try:
+            record = json.loads(manifest.read_text(encoding="utf-8"))
+            if record["schema_version"] != _SCHEMA:
+                raise ValueError("unknown installation version")
+            recipe = SharedToolRecipe(**record["recipe"])
+            digest = record["launcher_sha256"]
+            if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
+                raise ValueError("invalid launcher digest")
+        except (OSError, KeyError, TypeError, ValueError, InvalidInputError) as error:
+            raise StateMismatchError("Shared tool manifest is invalid") from error
+        if recipe.name != name:
+            raise StateMismatchError("Shared tool manifest has the wrong identity")
+        return recipe, digest
+
+    def _launcher(self, root: Path, recipe: SharedToolRecipe) -> Path:
+        entrypoint = root.joinpath(*_relative_file(recipe.entrypoint).parts)
+        if (
+            entrypoint.is_symlink()
+            or not entrypoint.is_file()
+            or not entrypoint.resolve(strict=True).is_relative_to(root.resolve(strict=True))
+        ):
+            raise ScopeDeniedError("Shared tool launcher is not a confined regular file")
+        return entrypoint
+
+    @staticmethod
+    def _digest(path: Path) -> str:
+        with path.open("rb") as handle:
+            return hashlib.file_digest(handle, "sha256").hexdigest()
+
+    def _verify(self, name: str, *, abi_tag: str) -> SharedToolUse:
+        recipe, digest = self._read_recipe(name)
+        root = self._location(name)
+        checkout = root / "checkout"
+        if abi_tag != recipe.abi_tag:
+            raise StateMismatchError("Shared tool binaries or environment have a different ABI")
+        if (
+            checkout.is_symlink()
+            or (checkout / ".git").is_symlink()
+            or not (checkout / ".git").is_dir()
+        ):
+            raise ScopeDeniedError("Shared tool Git directory is missing or redirected")
+        if self._git("-C", str(checkout), "rev-parse", "HEAD") != recipe.commit:
+            raise StateMismatchError("Installed tool source revision has changed")
+        if self._git("-C", str(checkout), "status", "--porcelain=1", "--ignored"):
+            raise StateMismatchError("Installed tool checkout is dirty; clean before reuse")
+        launcher = self._launcher(root, recipe)
+        if self._digest(launcher) != digest:
+            raise StateMismatchError("Shared tool executable changed after publication")
+        return SharedToolUse(
+            root,
+            checkout,
+            launcher,
+            root / "environment",
+            recipe.commit,
+            recipe.abi_tag,
+            self.model_environment(recipe),
+        )
+
+    @staticmethod
+    def model_environment(recipe: SharedToolRecipe) -> dict[str, str]:
+        if not recipe.downloads_models:
+            return {}
+        # A tool-specific installer still has to verify its actual download paths.
+        return {
+            "HF_HOME": "/var/ai/huggingface",
+            "HF_HUB_CACHE": "/var/ai/huggingface/hub",
+            "HUGGINGFACE_HUB_CACHE": "/var/ai/huggingface/hub",
+            "TRANSFORMERS_CACHE": "/var/ai/transformers",
+            "TORCH_HOME": "/var/ai/torch",
+            "OLLAMA_MODELS": "/var/ai/ollama",
+        }
+
+    def stage(self, recipe: SharedToolRecipe, source_checkout: Path) -> Path:
+        """Copy an admitted local source into the shared library without network.
+
+        An installer action may subsequently put reviewed downloads, build outputs,
+        and relocatable environments into the sibling static directories before
+        calling ``register``. This method does not execute source code.
+        """
+        source = self.sandbox.confine(
+            source_checkout, area="repository", must_exist=True
+        )
+        if source.is_symlink() or (source / ".git").is_symlink() or not (source / ".git").is_dir():
+            raise ScopeDeniedError("Installation source must be a local Git checkout")
+        if self._git("-C", str(source), "rev-parse", "HEAD") != recipe.commit:
+            raise StateMismatchError("Tool source does not match its pinned commit")
+        if self._git("-C", str(source), "status", "--porcelain=1", "--ignored"):
+            raise StateMismatchError("Tool source must be clean before staging")
+        with self._lock(recipe.name, exclusive=True):
+            root = self._location(recipe.name)
+            if root.exists() or root.is_symlink():
+                raise StateMismatchError("Shared tool staging destination already exists")
+            root.mkdir(mode=0o2770)
+            if os.name == "posix":
+                root.chmod(0o2770)
+            try:
+                self._git(
+                    "clone", "--local", "--no-hardlinks", "--no-checkout", "--",
+                    str(source), str(root / "checkout"),
+                )
+                self._git("-C", str(root / "checkout"), "checkout", "--detach", recipe.commit)
+                for directory in _STATIC_DIRS:
+                    folder = root / directory
+                    folder.mkdir(mode=0o2770)
+                    if os.name == "posix":
+                        folder.chmod(0o2770)
+            except BaseException:
+                shutil.rmtree(root)
+                raise
+        return root
+
+    def register(self, recipe: SharedToolRecipe) -> None:
+        """Publish an already staged, independently approved and built tool.
+
+        The installer is responsible for putting a *clean* Git checkout and any
+        pre-downloaded/prebuilt files in the tool root before calling this gate.
+        No arbitrary install scripts run in the Potbot operator process.
+        """
+        with self._lock(recipe.name, exclusive=True):
+            root = self._location(recipe.name)
+            if not root.is_dir() or self._manifest_path(recipe.name).exists():
+                raise StateMismatchError("Tool must be staged but not already published")
+            checkout = root / "checkout"
+            if (
+                checkout.is_symlink()
+                or (checkout / ".git").is_symlink()
+                or not (checkout / ".git").is_dir()
+            ):
+                raise ScopeDeniedError("Tool staging needs an independent Git checkout")
+            if self._git("-C", str(checkout), "rev-parse", "HEAD") != recipe.commit:
+                raise StateMismatchError("Tool source is not at its pinned commit")
+            if self._git("-C", str(checkout), "status", "--porcelain=1", "--ignored"):
+                raise StateMismatchError("Tool installation must begin from a clean checkout")
+            for directory in _STATIC_DIRS:
+                folder = root / directory
+                if folder.is_symlink():
+                    raise ScopeDeniedError("Static artifact directory cannot be a link")
+                folder.mkdir(exist_ok=True)
+            launcher = self._launcher(root, recipe)
+            # The authoritative manifest is controller-owned, never stored in
+            # the group-writable tool root where another agent could replace it.
+            record = {
+                "schema_version": _SCHEMA,
+                "recipe": asdict(recipe),
+                "launcher_sha256": self._digest(launcher),
+                "static_areas": list(_STATIC_DIRS),
+                "runtime_areas": ["/home/user/.cache/tools", "/home/user/.local/state/tools"],
+            }
+            manifest = self._manifest_path(recipe.name)
+            temporary = manifest.with_suffix(".tmp")
+            if temporary.is_symlink() or temporary.exists():
+                raise ScopeDeniedError("Tool staging metadata path is already occupied")
+            with temporary.open("x", encoding="utf-8") as stream:
+                json.dump(record, stream, sort_keys=True, indent=2)
+                stream.write("\n")
+                stream.flush()
+                os.fsync(stream.fileno())
+            temporary.replace(manifest)
+
+    @contextmanager
+    def use(self, name: str, *, abi_tag: str) -> Iterator[SharedToolUse]:
+        """Keep this context open for the *entire* supervised tool invocation."""
+        with self._lock(name, exclusive=False):
+            yield self._verify(name, abi_tag=abi_tag)
+
+    def clean(self, name: str) -> None:
+        """Reset only Git source; static build/download/env siblings survive."""
+        with self._lock(name, exclusive=True):
+            recipe, _ = self._read_recipe(name)
+            self._clean_source(self._location(name) / "checkout", recipe.commit)
+            self._verify(name, abi_tag=recipe.abi_tag)
+
+    def fork_for_edit(self, name: str, agent_id: str) -> Path:
+        """Clean shared source then make an independent offline agent clone."""
+        home = self.sandbox.agent_home(agent_id)
+        destination = home / "Projects" / name
+        with self._lock(name, exclusive=True):
+            recipe, _ = self._read_recipe(name)
+            self._clean_source(self._location(name) / "checkout", recipe.commit)
+            self._verify(name, abi_tag=recipe.abi_tag)
+            destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+            if destination.exists() or destination.is_symlink():
+                raise StateMismatchError("Agent tool checkout already exists")
+            # No hardlinks, alternates or network dependency on the shared repo.
+            self._git(
+                "clone", "--local", "--no-hardlinks", "--no-checkout", "--",
+                str(self._location(name) / "checkout"), str(destination),
+            )
+            try:
+                self._git("-C", str(destination), "checkout", "--detach", recipe.commit)
+                if self._git("-C", str(destination), "status", "--porcelain=1", "--ignored"):
+                    raise StateMismatchError("Agent clone is not clean")
+            except BaseException:
+                shutil.rmtree(destination)
+                raise
+        return destination
+
+    def clean_agent_runtime(self, name: str, agent_id: str) -> None:
+        """Drop this agent's tool-specific scratch only, never its checkout."""
+        home = self.sandbox.agent_home(agent_id)
+        with self._lock(name, exclusive=True):
+            self._read_recipe(name)
+            for area in _RUNTIME_DIRS:
+                root = home / ".cache" if area == "cache" else home / ".local" / area
+                parent = root / "tools"
+                location = parent / name
+                if any(path.is_symlink() for path in (root, parent, location)):
+                    raise ScopeDeniedError("Agent runtime cleanup cannot follow links")
+                if not location.resolve().is_relative_to(home.resolve(strict=True)):
+                    raise ScopeDeniedError("Agent runtime cleanup would leave its private home")
+                if location.exists():
+                    if not location.is_dir():
+                        raise ScopeDeniedError("Agent tool runtime path is not a directory")
+                    shutil.rmtree(location)
diff --git a/scripts/shared_tool_admin.py b/scripts/shared_tool_admin.py
new file mode 100644
--- /dev/null
+++ b/scripts/shared_tool_admin.py
@@ -0,0 +1,58 @@
+"""Trusted operator workflow for offline staged Potbot shared-tool installations.
+
+Do not give this script to a model as a shell tool; the controller must separately
+approve staging, publication, cleaning and cloning and record operation receipts.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from potbot.tools.shared_installations import SharedToolRecipe, SharedToolStore
+from potbot.workspace_sandbox import WorkspaceSandbox
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sandbox-root", type=Path, required=True)
+    commands = parser.add_subparsers(dest="command", required=True)
+    commands.add_parser("prepare-home").add_argument("agent_id")
+    stage = commands.add_parser("stage")
+    stage.add_argument("--recipe", type=Path, required=True)
+    stage.add_argument("--source", type=Path, required=True)
+    publish = commands.add_parser("publish")
+    publish.add_argument("--recipe", type=Path, required=True)
+    for name in ("clean", "fork", "clean-agent-runtime"):
+        op = commands.add_parser(name)
+        op.add_argument("tool")
+        if name != "clean":
+            op.add_argument("agent_id")
+    args = parser.parse_args(argv)
+    sandbox = WorkspaceSandbox.existing(args.sandbox_root)
+    store = SharedToolStore(sandbox)
+    if args.command == "prepare-home":
+        value = sandbox.agent_home(args.agent_id)
+    elif args.command in {"stage", "publish"}:
+        # Recipes must be prepared and approved independently by the operator.
+        recipe = SharedToolRecipe(**json.loads(args.recipe.read_text(encoding="utf-8")))
+        if args.command == "stage":
+            value = store.stage(recipe, args.source)
+        else:
+            store.register(recipe)
+            value = store.root / recipe.name
+    elif args.command == "clean":
+        store.clean(args.tool)
+        value = store.root / args.tool / "checkout"
+    elif args.command == "fork":
+        value = store.fork_for_edit(args.tool, args.agent_id)
+    else:
+        store.clean_agent_runtime(args.tool, args.agent_id)
+        value = sandbox.agent_home(args.agent_id)
+    print(json.dumps({"operation": args.command, "path": str(value)}, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
