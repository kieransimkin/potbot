 #!/bin/bash
-# Adapted from Kieran Simkin's update-motd.d-scripts, pinned revision
-# 2485c90143dae3dd336769e7ab68ebcca781fa8a.
-# This is a cosmetic interactive login hook; never authorize actions here.
+# Personalizable interactive Bash greeting, based on the pinned Kieran Simkin
+# update-motd.d-scripts. Cosmetic only: no command evaluation, network or installs.
 set -u
-motd="$HOME/.local/share/potbot/motd.d"
 if [ "${POTBOT_WELCOME:-1}" = 0 ] || [ ! -t 1 ]; then
     exit 0
 fi
-# All original scripts expect lolcat; the first expects figlet and the
-# second fortune. Missing optional utilities are skipped, not downloaded.
-if [ -x /usr/games/lolcat ]; then
-    if command -v figlet >/dev/null 2>&1; then
-        bash "$motd/10-figbanner" || :
+
+config="$HOME/.config/potbot"
+agent_dir="${HOME##*/}"
+title="Workspace"
+# A 64-character hex directory is the anonymous agent identity. Once the
+# controller renames it, the chosen directory name becomes the banner default.
+if [[ "$agent_dir" =~ ^[[:xdigit:]]{64}$ ]]; then
+    if [ -f "$config/workspace-name" ] && [ ! -L "$config/workspace-name" ]; then
+        IFS= read -r title < "$config/workspace-name" || :
+    fi
+else
+    title="${agent_dir//[-_]/ }"
+    # A named agent may override its banner without modifying the host registry.
+    if [ -f "$config/banner.title" ] && [ ! -L "$config/banner.title" ]; then
+        IFS= read -r title < "$config/banner.title" || :
+    fi
+fi
+# A guest can edit these cosmetic files. Never evaluate shell fragments or
+# forward terminal control characters to figlet.
+title="${title:0:48}"
+if [[ ! "$title" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]*$ ]]; then
+    title="Workspace"
+fi
+
+font="standard"
+if [ -f "$config/banner.font" ] && [ ! -L "$config/banner.font" ]; then
+    IFS= read -r preferred < "$config/banner.font" || :
+    case "$preferred" in
+        standard|slant|small|big|shadow|banner) font="$preferred" ;;
+    esac
+fi
+color="rainbow"
+if [ -f "$config/banner.color" ] && [ ! -L "$config/banner.color" ]; then
+    IFS= read -r preferred < "$config/banner.color" || :
+    case "$preferred" in
+        plain|rainbow) color="$preferred" ;;
+    esac
+fi
+
+motd="$HOME/.local/share/potbot/motd.d"
+if command -v figlet >/dev/null 2>&1; then
+    # Use the upstream 10-figbanner's figlet/lolcat treatment with a dynamic
+    # title. The original source remains copied intact in motd.d for provenance.
+    if [ "$color" = rainbow ] && [ -x /usr/games/lolcat ]; then
+        figlet -c -f "$font" "$title" | /usr/games/lolcat -f || :
+    else
+        figlet -c -f "$font" "$title" || :
     fi
-    if [ -x /usr/games/fortune ]; then
+fi
+if [ -x /usr/games/lolcat ]; then
+    if [ -x /usr/games/fortune ] && [ -f "$motd/20-fortune" ]; then
         bash "$motd/20-fortune" || :
     fi
-    bash "$motd/99-insult" || :
+    if [ -f "$motd/99-insult" ]; then
+        bash "$motd/99-insult" || :
+    fi
 fi
diff --git a/tests/unit/test_agent_skeleton.py b/tests/unit/test_agent_skeleton.py
index 92a0890..0ed4b4f 100644
--- a/tests/unit/test_agent_skeleton.py
+++ b/tests/unit/test_agent_skeleton.py
@@ -204,3 +204,91 @@ def test_build_includes_vendor_assets_and_required_tools():
     recipe = (repo / "sandbox/image/Dockerfile").read_text(encoding="utf-8")
     for package in ("figlet", "fortune-mod", "fortunes-min", "lolcat"):
         assert package in recipe
+
+
+def _interactive_banner(agent_home: Path) -> str:
+    """Exercise a genuine interactive Bash PTY with an observable figlet fixture."""
+    tool = agent_home / ".local/bin/figlet"
+    tool.write_text('#!/bin/sh\nprintf "FIGLET:%s\\n" "$*"\n', encoding="utf-8")
+    tool.chmod(0o755)
+    master, slave = os.openpty()
+    try:
+        process = subprocess.Popen(
+            ["bash", "--noprofile", "-i", "-c", ":"],
+            env={"HOME": str(agent_home), "PATH": "/usr/bin:/bin",
+                 "POTBOT_WELCOME": "1", "TERM": "xterm-256color"},
+            stdin=slave, stdout=slave, stderr=slave, start_new_session=True,
+        )
+        os.close(slave)
+        slave = -1
+        process.wait(timeout=5)
+        chunks = bytearray()
+        while True:
+            try:
+                chunk = os.read(master, 4096)
+            except OSError:
+                break
+            if not chunk:
+                break
+            chunks.extend(chunk)
+        assert process.returncode == 0
+        return chunks.decode("utf-8", errors="replace")
+    finally:
+        os.close(master)
+        if slave != -1:
+            os.close(slave)
+
+
+def test_workspace_banner_switches_to_named_agent_style(registry):
+    if not shutil.which("bash"):
+        pytest.skip("Bash not installed")
+    owner, workspace, home = registry
+    agent_id = uuid4()
+    anonymous = owner.provision(workspace, agent_id)
+    root = home / anonymous.directory
+    assert (root / ".config/potbot/workspace-name").read_text() == "danceflow\n"
+    meta = json.loads((root / ".config/potbot/skeleton.json").read_text())
+    assert meta["workspace_display_name"] == "danceflow"
+    assert "FIGLET:-c -f standard danceflow" in _interactive_banner(root)
+
+    # The title override must be ignored until the agent is formally named.
+    (root / ".config/potbot/banner.title").write_text("Velvet Volt\n", encoding="utf-8")
+    assert "FIGLET:-c -f standard danceflow" in _interactive_banner(root)
+
+    named = owner.rename(workspace, agent_id, "velvet-volt", expected_revision=1)
+    named_root = home / named.directory
+    assert "FIGLET:-c -f standard Velvet Volt" in _interactive_banner(named_root)
+    # Removing an override exposes the default name chosen during rename.
+    (named_root / ".config/potbot/banner.title").unlink()
+    assert "FIGLET:-c -f standard velvet volt" in _interactive_banner(named_root)
+
+    (named_root / ".config/potbot/banner.title").write_text("Electric Dreams\n")
+    (named_root / ".config/potbot/banner.font").write_text("slant\n")
+    (named_root / ".config/potbot/banner.color").write_text("plain\n")
+    assert "FIGLET:-c -f slant Electric Dreams" in _interactive_banner(named_root)
+    assert owner.provision(workspace, agent_id) == named
+    assert (named_root / ".config/potbot/banner.title").read_text() == "Electric Dreams\n"
+
+
+def test_invalid_banner_customization_is_not_executed(registry):
+    if not shutil.which("bash"):
+        pytest.skip("Bash not installed")
+    owner, workspace, home = registry
+    agent_id = uuid4()
+    anon = owner.provision(workspace, agent_id)
+    named = owner.rename(workspace, agent_id, "safe-agent", expected_revision=1)
+    root = home / named.directory
+    (root / ".config/potbot/banner.title").write_text("Hi$(touch /tmp/UNSAFE)\n")
+    (root / ".config/potbot/banner.font").write_text("../../home/attacker\n")
+    result = _interactive_banner(root)
+    assert "FIGLET:-c -f standard Workspace" in result
+    assert "UNSAFE" not in result
+
+
+def test_workspace_banner_normalizes_unicode_and_bounds_length():
+    from potbot.tools.agent_skeleton import workspace_banner_label
+
+    assert workspace_banner_label("DanceFlow 🎸 Studio") == "DanceFlow Studio"
+    assert workspace_banner_label("électric nights") == "electric nights"
+    assert workspace_banner_label("🎉") == "Workspace"
+    assert len(workspace_banner_label("A" * 180)) == 48
