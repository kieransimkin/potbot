{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:potbot:schema:semantic-placement:1",
  "title": "Opt-in Potbot hierarchy and advisory primitive placements",
  "description": "A versioned design catalog. Recommendations are separate from type ancestry, imported instance kinds, APS payload validation, authorization and object lifecycle. This document is not an import compatibility gate.",
  "$comment": "Runtime checks additionally reject cross-scheme duplicates, unknown references, graph cycles, missing authored placements and native/protected definition replacement.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "const": "urn:potbot:semantic-placement:0.1.0"
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "draft"
    },
    "provenance": {
      "type": "object"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/syn_type"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/placement"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "primitive_kinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/primitive"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "reuse_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reuse"
      }
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "status",
    "provenance",
    "types",
    "placements",
    "primitive_kinds",
    "relations",
    "reuse_decisions"
  ],
  "additionalProperties": false,
  "$defs": {
    "type_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 268,
      "pattern": "^(?:syn|synny)://type/(?=[a-z0-9_-]{1,255}(?![\\s\\S]))[a-z0-9]+(?:[-_][a-z0-9]+)*(?![\\s\\S])",
      "description": "Exact Type reference under either scheme, with a slug of 1..255 characters. syn://type/<slug> and synny://type/<slug> identify the same Type within a selected catalog. Source spelling is preserved; catalog normalization prefers syn:// for native types and synny:// for protected potbot-data- slugs. Catalog merge rejects snapshot-supplied definitions using a protected slug under either scheme."
    },
    "object_ref": {
      "type": "string",
      "pattern": "^syn://(?:thing|event|ember|cog|credential|enigma|pondle|snug|om)/(?=[a-z0-9_-]{1,255}(?![\\s\\S]))[a-z0-9]+(?:[-_][a-z0-9]+)*(?![\\s\\S])",
      "description": "An exact non-Type local reference. The slug is limited to 255 characters for the SQL/HTTP boundary, which is stricter than SYN's general Python ObjectRef constructor."
    },
    "nonblank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "public_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2000000,
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "object"
      },
      "description": "Exact UTF-8 JSON object text, retained without reserialization. Runtime validation enforces the byte limit and rejects duplicate keys, non-finite constants, and privateData/private_data keys at every object depth."
    },
    "syn_property": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S",
          "not": {
            "pattern": "\\u0000"
          }
        },
        "type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "default": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "default": 1
        }
      },
      "required": [
        "name",
        "type_ref",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "syn_type": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/type_ref"
        },
        "name": {
          "$ref": "#/$defs/nonblank_string",
          "not": {
            "pattern": "\\u0000"
          }
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type_ref"
          },
          "uniqueItems": true
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "not": {
            "type": "string",
            "pattern": "\\u0000"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syn_property"
          }
        },
        "metadata_json": {
          "$ref": "#/$defs/public_json",
          "default": "{}"
        }
      },
      "required": [
        "ref",
        "name",
        "parents",
        "definition",
        "properties",
        "metadata_json"
      ],
      "additionalProperties": false
    },
    "syn_object": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/object_ref"
        },
        "type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "payload_json": {
          "$ref": "#/$defs/public_json",
          "contentSchema": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/object_ref"
              },
              "typeRef": {
                "$ref": "#/$defs/type_ref"
              },
              "name": {
                "$ref": "#/$defs/nonblank_string"
              }
            },
            "required": [
              "id",
              "typeRef",
              "name"
            ]
          }
        }
      },
      "required": [
        "ref",
        "type_ref",
        "payload_json"
      ],
      "additionalProperties": false
    },
    "primitive_kind": {
      "enum": [
        "type",
        "thing",
        "event",
        "ember",
        "cog",
        "credential",
        "enigma",
        "pondle",
        "snug",
        "om"
      ]
    },
    "related_view": {
      "type": "object",
      "properties": {
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "target_type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "target_kind": {
          "$ref": "#/$defs/primitive_kind"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requires_distinct_identity": {
          "const": true
        }
      },
      "required": [
        "relation",
        "target_type_ref",
        "target_kind",
        "reason",
        "requires_distinct_identity"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "abstract": {
          "type": "boolean"
        },
        "preferred_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/primitive_kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "related_views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/related_view"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type_ref",
        "abstract",
        "preferred_kind",
        "rationale",
        "related_views",
        "caveats"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "abstract": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "preferred_kind": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "preferred_kind": {
                "$ref": "#/$defs/primitive_kind"
              }
            }
          }
        }
      ]
    },
    "primitive": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/primitive_kind"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "native_root_type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "instance_type_ref_required": {
          "type": "boolean"
        },
        "extra_fields": {
          "type": [
            "object",
            "array"
          ]
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "description",
        "native_root_type_ref",
        "instance_type_ref_required",
        "extra_fields",
        "caveats"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "allowed_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primitive_kind"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "type_ref",
        "allowed_kinds"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 1
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 1
        },
        "requires_distinct_identity": {
          "const": true
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "description",
        "domains",
        "ranges",
        "requires_distinct_identity",
        "caveats"
      ],
      "additionalProperties": false
    },
    "reuse": {
      "type": "object",
      "properties": {
        "type_ref": {
          "$ref": "#/$defs/type_ref"
        },
        "preferred_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/primitive_kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type_ref",
        "preferred_kind",
        "decision",
        "rationale",
        "caveats"
      ],
      "additionalProperties": false
    }
  }
}
