{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:potbot:schema:artifact-embedding-manifest:1",
  "title": "Current named embeddings for an immutable artifact",
  "$comment": "Derived output, not a mutation of artifact bytes or a grant of access. Service validation checks current source ownership, source/profile hashes, view bindings and map-key/name agreement. source_text_v1 input hashes equal the artifact digest. Duplicate vector IDs or source/name/space materializations are rejected by typed validation, including nonidentical duplicates. Published agent-sem 0.1.0 schemas remain unchanged.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "workspace_id": {"$ref": "#/$defs/uuid"},
    "artifact_id": {"$ref": "#/$defs/uuid"},
    "artifact_digest": {"$ref": "#/$defs/sha256"},
    "byte_length": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
    "named_embeddings": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/embedding_name"},
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/named_embedding_reference"},
        "minItems": 1,
        "uniqueItems": true
      }
    }
  },
  "required": [
    "schema_version", "workspace_id", "artifact_id", "artifact_digest",
    "byte_length", "media_type", "named_embeddings"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$(?![\\s\\S])"
    },
    "named_embedding_reference": {
      "type": "object",
      "properties": {
        "embedding_name": {"$ref": "#/$defs/embedding_name"},
        "view_id": {"$ref": "#/$defs/uuid"},
        "vector_id": {"$ref": "#/$defs/uuid"},
        "source_id": {"$ref": "#/$defs/uuid"},
        "repository_id": {"$ref": "#/$defs/uuid"},
        "source_key": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_content_hash": {"$ref": "#/$defs/sha256"},
        "space_id": {"$ref": "#/$defs/uuid"},
        "profile_hash": {"$ref": "#/$defs/sha256"},
        "encoding_input_hash": {"$ref": "#/$defs/sha256"},
        "input_format": {"const": "source_text_v1"},
        "dimensions": {"type": "integer", "const": 1024},
        "metric": {"const": "cosine"},
        "generation": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "usage_origin": {"enum": ["synthetic", "measured", "provider_reported"]}
      },
      "required": [
        "embedding_name", "view_id", "vector_id", "source_id", "repository_id", "source_key",
        "source_content_hash", "space_id", "profile_hash", "encoding_input_hash", "input_format",
        "dimensions", "metric", "generation", "usage_origin"
      ],
      "additionalProperties": false
    }
  }
}
