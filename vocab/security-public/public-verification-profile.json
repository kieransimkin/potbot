  "hourly_signing_profile": "potbot-hourly-signing-v1",
  "base_path": "m/6969'/420'/0'/0/0",
  "hourly_path_template": "m/6969'/420'/0'/0/0/1'/{signing_epoch}'",
  "publication": {
    "base_public_key": true,
    "hourly_public_key": true,
    "base_signer_hash": true,
