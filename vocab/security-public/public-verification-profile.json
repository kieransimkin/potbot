    "private_key": false,
    "chain_code": false,
    "mnemonic": false
  },
  "canonicalization": {
    "name": "RFC-8785-JCS restricted ASCII/integer/object subset",
    "maximum_bytes": 65536,
    "duplicate_keys": false,
    "floats": false,
    "nonfinite_numbers": false,
    "booleans": false,
    "null": false,
    "arrays": false,
    "signed_aliases": "preserve exact received spelling"
  },
  "delegation": {
    "schema": "synny://schema/hourly-key-delegation/v1",
    "message_prefix_ascii": "potbot-hourly-delegation-v1",
    "prefix_terminator_byte": 0,
    "omit_only_field": "signature",
    "signing_key": "derived base identity key",
    "binding": "fixed profile, base signer hash, hourly raw public key, integer epoch, exact epoch interval"
  },
  "signature": {
    "schema": "synny://schema/signature-envelope/v2",
    "message_prefix_ascii": "potbot-signature-v2",
    "prefix_terminator_byte": 0,
    "omit_only_field": "signature",
    "signing_key": "hardened hourly key",
    "maximum_validity_seconds": 300,
    "maximum_clock_skew_seconds": 30
  },
  "trust": {
