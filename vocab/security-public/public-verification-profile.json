    "scope": "independent audience, workspace UUID, domain, and registered payload type allowlist",
    "repeatable_verification": "does not authorize effects or consume request IDs",
    "one_time_acceptance": "atomic durable signer_hash/request_id reservation through expiry plus permitted skew"
  }
